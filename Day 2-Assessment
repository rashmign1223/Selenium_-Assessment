package SeleniumAssessement1;

import java.io.File;
import java.io.IOException;
import java.time.Duration;

import org.openqa.selenium.By;
import org.openqa.selenium.OutputType;
import org.openqa.selenium.Rectangle;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.io.FileHandler;

public class Assessment3 {
	public static void main(String[] args) throws IOException, InterruptedException {
		 WebDriver driver = new ChromeDriver();

	        driver.manage().window().maximize();
	        driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
	        driver.get("https://demowebshop.tricentis.com/");
	        WebElement laptop = driver.findElement(By.xpath("//a[contains(text(),'14.1-inch Laptop')]"));
	        System.out.println("Laptop identified successfully");
	        WebElement addToCart =driver.findElement(By.xpath("//a[contains(text(),'14.1-inch Laptop')]/ancestor::div[contains(@class,'product-item')]//input[@value='Add to cart']"));
	        
	    System.out.println(addToCart.getSize().getWidth());
	    System.out.println( addToCart.getSize().getHeight());
	    addToCart.click();
	    driver.findElement(By.xpath("//span[text()='Shopping cart']")).click();
	    WebElement removeCheckbox =driver.findElement(By.name("removefromcart"));
        if (removeCheckbox.isSelected()) {
            System.out.println("Remove checkbox is selected");
        } else {
            System.out.println("Remove checkbox is NOT selected");
        }
        Rectangle rect = removeCheckbox.getRect();

        System.out.println("----- CHECKBOX RECT INFORMATION -----");

        System.out.println("X = " + rect.getX());
        System.out.println("Y = " + rect.getY());
        System.out.println("Width = " + rect.getWidth());
        System.out.println("Height = " + rect.getHeight());
        boolean messageBefore = driver.findElements(
                By.xpath("//*[contains(text(),'The coupon code is invalid')]"))
                .size() > 0;

        if (messageBefore) {
            System.out.println("Alert message displayed BEFORE clicking Apply Coupon");
        } else {
            System.out.println("Alert message NOT displayed BEFORE clicking Apply Coupon");
        }
    
        WebElement coupon = driver.findElement(By.name("discountcouponcode"));
        coupon.sendKeys("TEST123");

      
        WebElement applyCoupon =
                driver.findElement(By.name("applydiscountcouponcode"));

        applyCoupon.click();

        Thread.sleep(2000);
        if (driver.getPageSource().contains("The coupon code is invalid")) {
            System.out.println("Alert/message displayed AFTER clicking Apply Coupon");
        } else {
            System.out.println("Alert/message NOT displayed AFTER clicking Apply Coupon");
        }
        
        WebElement laptopImage =
                driver.findElement(By.xpath("//a[contains(text(),'14.1-inch Laptop')]/ancestor::tr//img"));

        File source = laptopImage.getScreenshotAs(OutputType.FILE);

        File destination =
                new File("./Ss2/laptop.png");

        FileHandler.copy(source, destination);

        System.out.println("Laptop screenshot captured successfully");

        driver.quit();
    }
}    
	        
	        
	

  


